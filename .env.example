# Create .env.local from this template. Production uses the host's secret store.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
GEOAPIFY_API_KEY=
# Optional. Verify the Free plan and its USD 5 platform limit before recording the token fingerprint.
APIFY_TOKEN=
APIFY_FREE_TOKEN_SHA256=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_PUBLIC_ACCESS=false
OPENAI_MODEL=gpt-6.2-sol
DATA_DIR=./data
CHAT_REQUESTS_PER_DAY=15
GLOBAL_CHAT_REQUESTS_PER_DAY=60
REPORTS_PER_DAY=9
GLOBAL_REPORTS_PER_DAY=36
RETENTION_DAYS=30
SOURCE_CODE_URL=
# Render webhook settings. Local polling leaves both empty.
DATABASE_URL=
TELEGRAM_WEBHOOK_SECRET=
